# ─── Talencia Backend Environment Variables ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talencia
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# mock | gemini | groq — defaults to mock so the whole team can build without keys
AI_PROVIDER_MODE=mock
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
JWT_SECRET=
